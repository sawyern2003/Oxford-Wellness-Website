# Default is 3000 when unset (Replit sets PORT=5000 in .replit).
PORT=3000

# Contact form — required for POST /api/contact (local, Replit, or Vercel serverless).
# On Vercel: Project → Settings → Environment Variables → Production (and Preview if desired).
SENDGRID_API_KEY=

# Google Ads conversion tracking (optional overrides).
# Defaults for production/preview builds are in client/.env.production (committed).
# If you set these in Vercel or a local .env, they override the committed defaults.
# Vite root is client/, so local overrides can also live in client/.env.local
# (gitignored). Values are embedded at build time — redeploy after changing them.
#
# Example override:
#   VITE_GOOGLE_ADS_ID=AW-123456789
#   VITE_GADS_BOOK_LABEL=AbCdEfGhIjKlMnOp
#   VITE_GADS_WHATSAPP_LABEL=QrStUvWxYz012345
#   VITE_GADS_TEL_LABEL=6789AbCdEfGhIjKl
#   VITE_GADS_BOOKING_COMPLETED_LABEL=ClinikoConfirmedLabel
# VITE_GOOGLE_ADS_ID=
# VITE_GADS_BOOK_LABEL=
# VITE_GADS_WHATSAPP_LABEL=
# VITE_GADS_TEL_LABEL=
# VITE_GADS_BOOKING_COMPLETED_LABEL=
